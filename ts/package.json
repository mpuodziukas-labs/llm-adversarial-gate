{
  "name": "llm-adversarial-gate-ts",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript port of the rule-based adversarial prompt gate, with a REST API and API tests",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test:unit": "vitest run",
    "start": "node dist/main.js",
    "test:api": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
